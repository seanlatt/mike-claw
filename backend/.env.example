PORT=3001
FRONTEND_URL=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# --- Storage backend ---
# Two options. Set ONE of these blocks.
#
# Option A: Local filesystem (dev/demo). Set this and leave R2_* blank.
# MIKE_LOCAL_STORAGE_DIR=/Users/you/clawdbot/mike/backend/.storage
MIKE_LOCAL_STORAGE_DIR=

# Option B: Cloudflare R2 (production). Requires all four.
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=mike

GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENROUTER_API_KEY=your-openrouter-key
RESEND_API_KEY=your-resend-key

# ----------------------------------------------------------------------------
# OpenClaw runtime
# ----------------------------------------------------------------------------
# Mike is OpenClaw-native: the LLM adapter shells out to the local `openclaw`
# CLI, which talks to the OpenClaw gateway over its WebSocket RPC. The gateway
# must be running and the CLI must be on PATH (or pointed to via
# OPENCLAW_CLI_PATH below).

# Informational — the gateway URL the openclaw CLI is configured to use.
# Mike does not call this URL directly; the CLI reads its own config.
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789

# Optional — populated only if you want to override the gateway token Mike
# would advertise (the openclaw CLI reads its own token from ~/.openclaw).
OPENCLAW_GATEWAY_TOKEN=

# Model selection shown to the UI. The gateway picks its own provider+model
# unless OPENCLAW_GROK_MODEL / OPENCLAW_OPENAI_MODEL is used for the
# "openclaw/grok" / "openclaw/gpt-4o" picker entries.
OPENCLAW_MODEL=openclaw/default
OPENCLAW_GROK_MODEL=grok-4.3
OPENCLAW_OPENAI_MODEL=gpt-4o

# Gateway agent + timeouts. agentId defaults to "main", which matches the
# single-operator OpenClaw install. Bump the timeout for slow models.
OPENCLAW_AGENT_ID=main
OPENCLAW_GATEWAY_TIMEOUT_MS=120000

# OPENCLAW_CLI is reserved by the gateway launchd service (it sets the var
# to "1" as a marker). Use OPENCLAW_CLI_PATH to point Mike at a non-PATH
# install of the openclaw binary.
OPENCLAW_CLI_PATH=

# Set true for offline UI development — the adapter returns a canned
# response instead of hitting the gateway. Health probe still reports ok.
OPENCLAW_USE_MOCK=false

# Set true to fall back to the canned response if the gateway is unreachable
# or errors out. Leave false in production so failures surface loudly.
OPENCLAW_FALLBACK_TO_MOCK=false

# Shared secret between Mike's backend and the mike-tools OpenClaw plugin.
# The plugin (which runs inside the OpenClaw gateway process) sends this
# value in the X-Mike-Internal header when it calls /openclaw/tools/*.
# Mike's backend rejects those routes when the header is missing or doesn't
# match. Generate with `openssl rand -hex 32`. Must also be set in the
# gateway process env so the plugin can read it.
MIKE_INTERNAL_TOKEN=
